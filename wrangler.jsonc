{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raphael-ia",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-16",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "raphaelia.com/*",
      "zone_name": "raphaelia.com"
    }
  ],
  "vars": {
    "APP_NAME": "Raphael IA",
    "APP_VERSION": "1.0.0"
  }
}
